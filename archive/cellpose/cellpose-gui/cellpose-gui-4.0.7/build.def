Bootstrap: docker
From: rockylinux/rockylinux:9-minimal

%labels
    Application python -m cellpose 
    Category segmentation
    Area biology
    Default true

%post
    # -------------------------
    # Basic dnf
    # -------------------------

    microdnf -y install dnf
    dnf -y update && dnf -y upgrade
    dnf install -y dnf-plugins-core
    dnf install -y epel-release
    dnf config-manager --set-enabled crb
    dnf install -y bash wget
    #  install VirtualGL
    VGL_LATEST=$(curl -ILs -o /dev/null -w %{url_effective} https://github.com/VirtualGL/virtualgl/releases/latest | cut -d '/' -f8)
    wget -P /opt https://github.com/VirtualGL/virtualgl/releases/download/$VGL_LATEST/VirtualGL-$VGL_LATEST.x86_64.rpm
    dnf install -y /opt/VirtualGL-*.rpm
    dnf -y install fontconfig libxkbcommon-x11 xcb-util-*

    # -------------------------
    # Optional dnf
    # -------------------------
    
    # suppress warning tha hostname command missing from VirtulaGL
    dnf -y install hostname

    # -------------------------
    # Python tooling
    # -------------------------

    # install miniforge in /opt
    wget -P /opt "https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-$(uname)-$(uname -m).sh"
    bash /opt/Miniforge3-$(uname)-$(uname -m).sh -b -p /opt/conda
    
    # make conda available during build
    . /opt/conda/etc/profile.d/conda.sh
    
    # -------------------------
    # Application creation
    # -------------------------

    export CONDA_OVERRIDE_CUDA=12.6
    conda env create -f /opt/cellpose-gui_env.yml
    conda activate cellpose-gui_env
    # exexcute rights for launchers
    for file in /opt/launchers/*; do chmod +x $file; done

    # -------------------------
    # Cleanup
    # -------------------------

    # Cleanup temporary files
    rm -rf /var/cache/dnf/*
    rm -f /var/log/dnf*
    rm -rf /root/.cache/pip
    rm -f /opt/Miniforge3-${MINIFORGE_VERSION}-$(uname)-$(uname -m).sh

%files
    files/cellpose-gui_env.yml /opt/cellpose-gui_env.yml
    launchers/* /opt/launchers/

%environment

%runscript
    /opt/launchers/start_cellpose-gui.sh "$@"
