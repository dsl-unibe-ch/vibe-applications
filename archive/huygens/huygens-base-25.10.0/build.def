Bootstrap: docker
From: rockylinux/rockylinux:9-minimal

%labels
    Application huygens 
    Category denoising
    Area biology
    Default true

%post
    # -------------------------
    # Basic dnf
    # -------------------------

    microdnf -y install dnf
    dnf -y update && dnf -y upgrade
    dnf install -y dnf-plugins-core
    dnf install -y epel-release
    dnf config-manager --set-enabled crb
    dnf install -y bash wget
    VGL_LATEST=$(curl -ILs -o /dev/null -w %{url_effective} https://github.com/VirtualGL/virtualgl/releases/latest | cut -d '/' -f8)
    wget -P /opt https://github.com/VirtualGL/virtualgl/releases/download/$VGL_LATEST/VirtualGL-$VGL_LATEST.x86_64.rpm
    dnf install -y /opt/VirtualGL-$VGL_LATEST.x86_64.rpm

    dnf config-manager --add-repo https://developer.download.nvidia.com/compute/cuda/repos/rhel9/x86_64/cuda-rhel9.repo
    # NOTE: Using cuda-toolkit version 12.2 since higher versions seems to fail to be detected (the cuda-toolkit) by Huygens.
    dnf -y install cuda-toolkit-12-2

    # -------------------------
    # Optional dnf
    # -------------------------

    # -------------------------
    # App installation
    # -------------------------
    cd /opt
    dnf -y install huygens-25.10.0-p1.x86_64_issue5960_cgroup_memLimit.rpm

    # -------------------------
    # Add execution permition to launcher
    # -------------------------

    chmod +x /opt/launchers/start_huygens.sh

    # -------------------------
    # Cleanup
    # -------------------------

    # Cleanup temporary files
    rm -rf /var/cache/dnf/*
    rm -f /var/log/dnf*
    rm -f /opt/huygens-25.10.0-p1.x86_64_issue5960_cgroup_memLimit.rpm
    dnf clean all

%files
    files/installer/huygens-25.10.0-p1.x86_64_issue5960_cgroup_memLimit.rpm /opt/huygens-25.10.0-p1.x86_64_issue5960_cgroup_memLimit.rpm
    launchers/start_huygens.sh /opt/launchers/start_huygens.sh

%environment
    export SVIHOME="$HOME/SVI/svi"

%runscript
    /opt/launchers/start_huygens.sh
